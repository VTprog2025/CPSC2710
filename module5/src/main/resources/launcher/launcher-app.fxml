<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>

<GridPane xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="edu.au.cpsc.launcher.LauncherController"
          stylesheets="@style/main.css"
          hgap="20"
          vgap="20"
          padding="20">

    <!-- Top-left button -->
    <Button fx:id="airports-btn"
            text="Airports"
            GridPane.rowIndex="0"
            GridPane.columnIndex="0"
            minWidth="120"
            minHeight="80"/>

    <!-- Top-right button -->
    <Button fx:id="seat-reservation-btn"
            text="Seat Reservation"
            GridPane.rowIndex="0"
            GridPane.columnIndex="1"
            minWidth="120"
            minHeight="80"/>

    <!-- Bottom-left button -->
    <Button fx:id="flight-schedule-btn"
            text="Flight Schedule"
            GridPane.rowIndex="1"
            GridPane.columnIndex="0"
            minWidth="120"
            minHeight="80"/>

    <!-- Bottom-right button -->
    <Button fx:id="aircraft-btn"
            text="Aircraft"
            GridPane.rowIndex="1"
            GridPane.columnIndex="1"
            minWidth="120"
            minHeight="80"/>

</GridPane>
