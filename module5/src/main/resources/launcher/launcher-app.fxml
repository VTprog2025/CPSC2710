<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>
<GridPane xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="edu.au.cpsc.launcher.LauncherController"
          styleClass="grid-pane"
          hgap="20"
          vgap="20"
          padding="20">

    <!-- Top-left button -->
    <Button fx:id="airport-btn"
            text="Airports"
            GridPane.rowIndex="0"
            GridPane.columnIndex="0"
            minWidth="120"
            minHeight="80"/>

    <!-- Top-right button -->
    <Button fx:id="seat-btn"
            text="Seat Reservation"
            GridPane.rowIndex="0"
            GridPane.columnIndex="1"
            minWidth="120"
            minHeight="80"/>

    <!-- Bottom-left button -->
    <Button fx:id="flight-btn"
            text="Flight Schedule"
            GridPane.rowIndex="1"
            GridPane.columnIndex="0"
            minWidth="120"
            minHeight="80"/>

    <!-- Bottom-right button -->
    <Button fx:id="airplane-btn"
            text="Aircraft"
            GridPane.rowIndex="1"
            GridPane.columnIndex="1"
            minWidth="120"
            minHeight="80"/>

</GridPane>