<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>

<GridPane xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="edu.au.cpsc.launcher.LauncherController"
          styleClass="grid-pane"
          hgap="20"
          vgap="20">

    <!-- Set padding using Insets -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Top-left button: Airports -->
    <Button fx:id="airportsBtn"
            text="Airports"
            GridPane.rowIndex="0"
            GridPane.columnIndex="0"
            minWidth="150"
            minHeight="100"/>

    <!-- Top-right button: Seat Reservation -->
    <Button fx:id="seatReservationBtn"
            text="Seat Reservation"
            GridPane.rowIndex="0"
            GridPane.columnIndex="1"
            minWidth="150"
            minHeight="100"/>

    <!-- Bottom-left button: Flight Schedule -->
    <Button fx:id="flightScheduleBtn"
            text="Flight Schedule"
            GridPane.rowIndex="1"
            GridPane.columnIndex="0"
            minWidth="150"
            minHeight="100"/>

    <!-- Bottom-right button: Aircraft -->
    <Button fx:id="aircraftBtn"
            text="Aircraft"
            GridPane.rowIndex="1"
            GridPane.columnIndex="1"
            minWidth="150"
            minHeight="100"/>
</GridPane>
