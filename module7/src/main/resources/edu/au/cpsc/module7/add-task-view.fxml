<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.au.cpsc.module7.AddTaskController"
      spacing="12" alignment="CENTER_LEFT"
      prefWidth="400.0" prefHeight="350.0"
      styleClass="dialog-pane">

    <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

    <Label text="Add New Task" styleClass="dialog-title"/>

    <Label text="Task Name:" styleClass="field-label"/>
    <TextField fx:id="nameField" promptText="Enter task name"/>

    <Label text="Description:" styleClass="field-label"/>
    <TextArea fx:id="descriptionArea" promptText="Enter description"
              prefRowCount="3" wrapText="true"/>

    <Label text="Priority:" styleClass="field-label"/>
    <ComboBox fx:id="priorityBox" prefWidth="150"/>

    <Label text="Due Date:" styleClass="field-label"/>
    <DatePicker fx:id="dueDatePicker" prefWidth="150"/>

    <Label fx:id="errorLabel" text="" styleClass="error-label"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="5"/></padding>
        <Button text="Save" onAction="#onSave" styleClass="btn-primary"/>
        <Button text="Cancel" onAction="#onCancel" styleClass="btn-secondary"/>
    </HBox>

</VBox>