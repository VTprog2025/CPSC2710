<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER_LEFT" prefHeight="398.0" prefWidth="400.0" spacing="12" styleClass="dialog-pane" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="edu.au.cpsc.module7.AddTaskController">

    <padding><Insets bottom="20" left="25" right="25" top="20" /></padding>

    <Label styleClass="dialog-title" text="Add New Task" />

    <Label styleClass="field-label" text="Task Name:" />
    <TextField fx:id="nameField" promptText="Enter task name" />

    <Label styleClass="field-label" text="Description:" />
    <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Enter description" wrapText="true" />

    <Label styleClass="field-label" text="Priority:" />
    <ComboBox fx:id="priorityBox" prefWidth="150" />

    <Label styleClass="field-label" text="Due Date:" />
    <DatePicker fx:id="dueDatePicker" prefWidth="150" />
     <Button onAction="#onSave" styleClass="btn-primary" text="Save" />
     <Button onAction="#onCancel" styleClass="btn-secondary" text="Cancel" />

    <Label fx:id="errorLabel" styleClass="error-label" text="" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <padding><Insets top="5" /></padding>
    </HBox>

</VBox>
