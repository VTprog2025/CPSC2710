<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.au.cpsc.module3_1.HelloController">

    <!-- Center: Data Section -->
    <center>
        <VBox prefHeight="400.0" prefWidth="400.0" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>

            <children>
                <!-- Search Fields TitledPane -->
                <TitledPane animated="false" text="Search">
                    <content>
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="200.0"/>
                            </columnConstraints>
                            <padding>
                                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                            </padding>
                            <children>
                                <Label text="Ident:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="identField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="IATA Code:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="iataField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Local Code:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="localCodeField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </children>
                        </GridPane>
                    </content>
                </TitledPane>

                <!-- Details Fields TitledPane -->
                <TitledPane animated="false" text="Details">
                    <content>
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="200.0"/>
                            </columnConstraints>
                            <padding>
                                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                            </padding>
                            <children>
                                <Label text="Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="typeField" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="nameField" editable="false" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Elevation:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="elevationField" editable="false" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Country:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <TextField fx:id="countryField" editable="false" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Region:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <TextField fx:id="regionField" editable="false" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                <Label text="Municipality:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                <TextField fx:id="municipalityField" editable="false" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                            </children>
                        </GridPane>
                    </content>
                </TitledPane>

                <!-- Search Button -->
                <Button text="Search" fx:id="searchButton"/>
            </children>
        </VBox>
    </center>

    <!-- Right: Map Section -->
    <right>
        <VBox prefHeight="400.0" prefWidth="400.0" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <children>
                <Label text="Map goes here" fx:id="mapPane" />
            </children>
        </VBox>
    </right>

</BorderPane>
