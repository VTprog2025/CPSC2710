<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.au.cpsc.module3_1.HelloController">

    <!-- Center: Data Section -->
    <center>
        <VBox prefHeight="400.0" prefWidth="400.0" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>

            <children>
                <!-- Search Fields -->
                <TitledPane animated="false" text="Search">
                    <content>
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="200.0" />
                            </columnConstraints>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <Label text="Ident:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="identField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="IATA Code:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="iataField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Local Code:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextField fx:id="localCodeField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            </children>
                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>
                    </content>
                </TitledPane>

                <!-- Details Fields -->
                <TitledPane animated="false" text="Details">
                    <content>
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="200.0" />
                            </columnConstraints>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="typeField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="nameField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Elevation:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextField fx:id="elevationField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Country:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <TextField fx:id="countryField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label text="Region:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <TextField fx:id="regionField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <Label text="Municipality:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                <TextField fx:id="municipalityField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            </children>
                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>
                    </content>
                </TitledPane>

                <!-- Search Button -->
                <Button fx:id="searchButton" text="Search" />
            </children>
        </VBox>
    </center>

    <!-- Right: Map Section -->
    <right>
        <VBox prefHeight="400.0" prefWidth="400.0" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <WebView fx:id="mapView" prefHeight="400.0" prefWidth="400.0" />
            </children>
        </VBox>
    </right>

</BorderPane>
